 "never_ship": [
  {"glob": "*.bcc_audit/*", "why": "raw forensic evidence: source documents, caches, screenshots"},
  {"glob": "*_evidence*.json", "why": "assertion-to-source citational payloads for named parties"},
  {"glob": "*_linkage*.json", "why": "entity-resolution output naming private individuals"},
  {"glob": "bcc_*.json", "why": "investigation intermediate naming officers, tenants and clinicians"},
  {"glob": "bcc_*.py", "why": "investigation scripts with hard-coded case identifiers"},
  {"glob": "BCC_*.html", "why": "rendered findings about identified organisations"},
  {"glob": "*findings*.md", "why": "narrative findings about identified people"},
  {"glob": "*findings*.html", "why": "rendered findings about identified people"},
  {"glob": "*person*.json", "why": "person-level records"},
  {"glob": "SIGNED_*", "why": "executed legal instruments"},
  {"glob": "*.eml", "why": "correspondence"},
  {"glob": "*.pdf", "why": "primary documents: ship the quote and its hash, not the file"},
  {"glob": "00_raw/*", "why": "raw fetch output, unsanitised"},
  {"glob": "*.zip", "why": "archives of primary documents"}
 ],
 "deny_substrings": [
  "bcc_audit",
  "REINVESTIGATION",
  "FETCH_LOG",
  "edge_proof_ledger",
  "identity_tiebreak",
  "new_sources_log"
 ],
 "rationale": {
  "why_allowlist": "A deny-list alone fails open: a new evidence directory ships unless someone remembers to add it. A manifest fails closed, and the gate refuses a path that is not declared.",
  "why_never_ship_evidence": "This project's method is publishable; the allegations inside its original case are not. Named individuals in a corpus of mental-health, tenancy and employment records are not experiment data, and no licence can make republishing them lawful or decent. The methodology, the instruments and the aggregate counts ship; the primary documents do not. Ship the quote and its hash, and let a verifier re-fetch.",
  "what_a_reader_can_verify_instead": "Every instrument in this repository runs against data the reader supplies. The evaluation numbers are reproducible from the labelled corpus; the forensic method is reproducible from its protocol documents."
 }
}
